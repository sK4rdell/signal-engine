# Every environment variable read by the binaries. Copy to .env for local
# development; the Makefile sources .env, the binaries never load it.

# development | test | production
ENV=development

# debug | info | warn | error
LOG_LEVEL=info
# json | text (production requires json)
LOG_FORMAT=text

# --- HTTP ---------------------------------------------------------------
HTTP_ADDR=:8080
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=15s
# Default request body limit in bytes (1 MiB).
# HTTP_MAX_BODY_BYTES=1048576
# Browser origins allowed for CORS and accepted in the Origin header of
# unsafe requests (CSRF protection). Comma separated. Production: https only.
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Reverse proxies whose X-Forwarded-For header is trusted. Comma separated
# IPs or CIDR ranges. Leave empty when clients reach the API directly.
# HTTP_TRUSTED_PROXIES=10.0.0.0/8
# Emit Strict-Transport-Security. Only when the API is reached over HTTPS.
# HTTP_HSTS=false

# --- Database -----------------------------------------------------------
# Required. Contains credentials: never logged. Production requires
# sslmode=require or stronger.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# DB_MAX_CONNS=10
# DB_MIN_CONNS=0
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m

# Used by `make test` only. Tests create throwaway databases from this
# connection and skip when it is unset or unreachable.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test?sslmode=disable

# --- Auth ---------------------------------------------------------------
# Required. 32 bytes, hex encoded (openssl rand -hex 32). Seals raw
# verification/reset tokens while they travel through the job queue. The
# value below is the well-known development key; production refuses it.
AUTH_ENCRYPTION_KEY=626574656d706c6174652d6465762d6b65792d646f2d6e6f742d757365212121
# AUTH_SESSION_TTL=720h
# AUTH_SESSION_COOKIE_NAME=session
# Defaults to true in production (and cannot be disabled there).
# AUTH_SESSION_COOKIE_SECURE=false
# AUTH_VERIFICATION_TOKEN_TTL=24h
# AUTH_RESET_TOKEN_TTL=1h
# Minimum time between two verification emails for one user.
# AUTH_RESEND_COOLDOWN=1m
# Frontend origin that verification and password reset links point to.
APP_BASE_URL=http://localhost:3000
# Per-client-IP limit on sensitive auth endpoints (fixed window).
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW=1m

# --- Email --------------------------------------------------------------
# smtp | log (log only outside production)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@localhost
# Development target is the compose Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# Refuse servers without STARTTLS. Defaults to true in production.
# SMTP_REQUIRE_TLS=false

# --- Background jobs ----------------------------------------------------
# JOBS_POLL_INTERVAL=1s
# JOBS_CONCURRENCY=4
# JOBS_JOB_TIMEOUT=1m
# JOBS_LOCK_TIMEOUT=5m
# JOBS_SHUTDOWN_TIMEOUT=30s
# Run the worker inside the API process. Handy locally so `make dev` alone
# delivers emails. Production refuses it: run cmd/worker separately.
JOBS_WORKER_IN_API=true

# --- Sources ------------------------------------------------------------
# Arbetsmiljöverket web diary, read by `make ingest` / cmd/ingest. Override
# the base URL only to point the client at a local test server.
# ARBETSMILJOVERKET_BASE_URL=https://www.av.se
# Minimum time between two requests to the source.
# ARBETSMILJOVERKET_REQUEST_INTERVAL=1s
# Naturvårdsverket Klimatklivet (approved applications dataset).
# KLIMATKLIVET_BASE_URL=https://www.naturvardsverket.se
